{
  "schemaVersion": 1,
  "id": "skypocket",
  "version": "${version}",
  "name": "SkyPocket",
  "description": "Client-side utility mod for Hypixel SkyBlock: custom crosshair, hand-item animation, block outline, entity hitboxes, and HUD widgets (FPS/TPS/Ping, clock, world day).",
  "authors": ["FriedLoop"],
  "icon": "assets/skypocket/icon.png",
  "contact": {
    "homepage": "https://github.com/FriedLoop/Skypocket-for-hypixel-skyblock",
    "sources": "https://github.com/FriedLoop/Skypocket-for-hypixel-skyblock",
    "issues": "https://github.com/FriedLoop/Skypocket-for-hypixel-skyblock/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.skypocket.SkyPocketMod"],
    "modmenu": ["dev.skypocket.gui.ModMenuIntegration"]
  },
  "mixins": [
    "skypocket.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": ">=26.2",
    "java": ">=25"
  },
  "recommends": {
    "modmenu": "*"
  }
}
